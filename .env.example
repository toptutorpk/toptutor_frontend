# Base URL for the Spring Boot backend API
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Toggle mock services (true = use in-memory mock data, false = hit real backend)
VITE_USE_MOCKS=true

# Google Maps API key (location-based search & map view)
VITE_GOOGLE_MAPS_API_KEY=

# Google OAuth 2.0 Web client ID for "Sign in with Google" (public value)
VITE_GOOGLE_CLIENT_ID=

# Public app metadata
VITE_APP_NAME=TopTutor

# Public marketing assets (brand film + poster) — separate R2 bucket, e.g.
# https://media.toptutor.pk  or  https://pub-<hash>.r2.dev
VITE_MEDIA_BASE_URL=
